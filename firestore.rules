rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      function hasValidShape() {
        return request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'email', 'provider', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.provider is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      }

      allow read: if isOwner();
      allow create: if isOwner()
        && hasValidShape()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.provider in ['password', 'google.com'];
      allow update: if isOwner()
        && hasValidShape()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.provider == resource.data.provider;
      allow delete: if false;

      match /favorites/{mealId} {
        function hasValidFavorite() {
          return request.resource.data.keys().hasOnly([
            'id', 'name', 'thumbnail', 'category', 'area', 'savedAt'
          ])
          && request.resource.data.id == mealId
          && request.resource.data.id is string
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.thumbnail is string
          && request.resource.data.thumbnail.size() > 0
          && (request.resource.data.category == null || request.resource.data.category is string)
          && (request.resource.data.area == null || request.resource.data.area is string)
          && request.resource.data.savedAt is timestamp
          && request.resource.data.savedAt == request.time;
        }

        allow read: if isOwner();
        allow create: if isOwner() && hasValidFavorite();
        allow update: if false;
        allow delete: if isOwner();
      }

      match /mealPlans/{weekId} {
        function hasValidWeek() {
          return request.resource.data.keys().hasAll(['weekStartDate', 'createdAt', 'updatedAt'])
            && request.resource.data.keys().hasOnly(['weekStartDate', 'createdAt', 'updatedAt'])
            && request.resource.data.weekStartDate == weekId
            && weekId.matches('^\\d{4}-\\d{2}-\\d{2}$')
            && request.resource.data.createdAt is timestamp
            && request.resource.data.updatedAt is timestamp
            && request.resource.data.updatedAt == request.time;
        }

        allow read: if isOwner();
        allow create: if isOwner()
          && hasValidWeek()
          && request.resource.data.createdAt == request.time;
        allow update: if isOwner()
          && hasValidWeek()
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner();

        match /meals/{mealId} {
          function hasValidMeal() {
            return request.resource.data.keys().hasAll([
              'mealId', 'date', 'recipeId', 'recipeName', 'recipeThumbnail', 'createdAt', 'updatedAt'
            ])
            && request.resource.data.keys().hasOnly([
              'mealId', 'date', 'recipeId', 'recipeName', 'recipeThumbnail', 'createdAt', 'updatedAt'
            ])
            && request.resource.data.mealId == mealId
            && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
            && request.resource.data.recipeId is string
            && request.resource.data.recipeId.size() > 0
            && request.resource.data.recipeName is string
            && request.resource.data.recipeName.size() > 0
            && request.resource.data.recipeThumbnail is string
            && request.resource.data.recipeThumbnail.size() > 0
            && request.resource.data.createdAt is timestamp
            && request.resource.data.updatedAt is timestamp
            && request.resource.data.updatedAt == request.time;
          }

          allow read: if isOwner();
          allow create: if isOwner()
            && hasValidMeal()
            && request.resource.data.createdAt == request.time;
          allow update: if isOwner()
            && hasValidMeal()
            && request.resource.data.mealId == resource.data.mealId
            && request.resource.data.date == resource.data.date
            && request.resource.data.createdAt == resource.data.createdAt;
          allow delete: if isOwner();
        }
      }
    }
  }
}
